# Use a long random token and keep it private. Never expose it in browser JavaScript.
AI_SERVICE_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET
AI_DATA_DIR=./data
FACE_MODEL=Facenet512
FACE_DETECTOR=opencv
MAX_UPLOAD_MB=25
QUEUE_SLEEP_SECONDS=1.5
# Cosine distance threshold; validate and tune using consented test images.
SIMILARITY_THRESHOLD=0.32
